# Copy to .env.local for local development. Never commit real keys.
# Each teammate uses their own key locally; the live site's key lives only in Vercel.

# Turns on "Start from a document" on the intake page. Leave blank to hide it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5. Use claude-sonnet-5-5 for messier CIMs (costs more).
DEALSPAN_AI_MODEL=

# Optional. If set, users must type this code before importing, so strangers can't spend your credits.
DEALSPAN_AI_ACCESS_CODE=
