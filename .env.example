# Copy to .env.local for local development. Never commit real keys.
# Each teammate uses their own key locally; the live site's key lives only in Vercel.

# Turns on both AI features: "Start from a document" on the intake page and the AI precedent search.
# Leave blank to hide both; the app then uses the 76-deal workbook only.
ANTHROPIC_API_KEY=

# Optional. Document import model. Defaults to claude-haiku-5-5. Use claude-sonnet-5-5 for messier CIMs (costs more).
DEALSPAN_AI_MODEL=

# Optional. Precedent search model. Defaults to claude-sonnet-5-5.
DEALSPAN_PRECEDENTS_MODEL=

# Optional. If set, users must type this code before importing a document, so strangers can't spend your credits.
DEALSPAN_AI_ACCESS_CODE=
